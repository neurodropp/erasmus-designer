      "source_class": "anonymized-aggregate-observation",
      "confidential_source": "not-retained",
      "required_evidence_fields": [
        "need_claim",
        "context_evidence",
        "target_group_link"
      ],
      "severity": "criterion-not-supported-if-relevant-and-material; never-automatic-eligibility",
      "counterexample": "A brief and contextual diagnosis may be enough; a new survey is not mandatory.",
      "expected_fix": "Check the available source, baseline limits and size of the need; do not invent consultations.",
      "observation_support": "qualitative-practice-partially-corroborated-by-anonymized-comments",
