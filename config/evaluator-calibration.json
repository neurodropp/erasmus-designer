  "matching_policy": {
    "storage": "RAM-only-no-private-case-table",
    "required": [
      "project-code-agreement",
      "verified-application-internal-title",
      "assessment-name-agreement-by-internal-field-or-exact-original-metadata",
      "unique-on-both-sides",
      "application-stage-confirmed",
      "scope-not-contradictory"
    ],
    "filename": "original-metadata-corroboration-only-never-sufficient-alone",
    "exclude": [
      "final-reports-as-applications",
      "ambiguous-roles",
      "multiple-or-discordant-project-references",
      "duplicate-counterparts",
      "explicit-beneficiary-reporting-stage"
    ],
    "zero_pairs": "report-limitation-no-invented-pair-no-score-fit",
    "title_extraction": "nonempty labeled application title; assessment internal field preferred, exact normalized metadata identity only when field absent; no minimum title length; placeholders excluded; layout-proven continuations; no fuzzy or narrative substring",
    "code_normalization": "Unicode equivalent separators, Unicode normalization, spaces and invisible break artifacts only; never OCR letter/digit repair or form-ID substitution",
    "stage_caution": "A narrative mention of final reporting does not establish the document stage; explicit report header or self-report Beneficiary Module template with retrospective questions does.",
    "code_hierarchy": "complete internal grant code primary; fallback only complete explicit grant code in original relative filename/folder; no generation from title or form-ID; any internal/metadata conflict rejects",
    "metadata_assessment_title_labels": [
      "evaluation sheet",
      "quality assessment",
      "assessment report",
      "evaluation report",
      "assessment",
      "valutazioni",
      "assessment",
      "evaluation",
      "esito",
      "esiti"
    ],
    "metadata_title_delimiters": [
      "spaces",
      "underscore",
      "ordinary hyphen"
    ],
    "metadata_code_scope": "verified application-stage body, exact target call-year/action context for metadata-code fallback; reject discordant scope; internal title conflict wins",
    "source_labels": [
      "verified-internal-pair",
      "metadata-corroborated-pair"
    ],
    "page_boundaries": "Split original text on formfeed before extracting titles or grant codes; never combine identity fragments across pages; preserve proven wrapping within each page; reject formfeed in metadata title identity."
  }
}
